# Production single-server deploy (leave API URL empty for same-origin)
NEXT_PUBLIC_API_URL=
NODE_ENV=production
PORT=3000
AUTH_PORT=3000
HOST=0.0.0.0
STATIC_DIR=out
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=random_webhook_secret
CORS_ORIGINS=https://x.verify.xyz,http://localhost:3000

# Admin (defaults on first boot: adminsheytoni / adminsheytoni)
ADMIN_DEFAULT_USERNAME=adminsheytoni
ADMIN_DEFAULT_PASSWORD=adminsheytoni

# Backblaze B2
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=your_bucket_name
B2_BUCKET_ID=
B2_PUBLIC_URL=

# Media cleanup
MEDIA_INACTIVE_DAYS=30
CHAT_MEDIA_MSG_LIMIT=100
MEDIA_CLEANUP_INTERVAL_MS=21600000
